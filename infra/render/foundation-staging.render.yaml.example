# Family OS controlled synthetic-staging Blueprint TEMPLATE.
# Oregon and Free plans are approved only for the temporary synthetic environment in
# docs/foundation/10_FREE_TIER_STAGING_ADMISSION_UPDATE.md. This file creates nothing by itself.
# Do not rename it to render.yaml or synchronize it until the sole Staging Owner follows
# docs/foundation/11_CONTROLLED_STAGING_OPERATOR_CONNECTION_CHECKLIST.md manually.
# Never add secret values, Firebase Admin keys, customer data paths, or Flutter configuration here.

services:
  - type: web
    name: family-os-foundation-staging
    runtime: node
    rootDir: backend
    region: oregon
    plan: free
    numInstances: 1
    autoDeployTrigger: 'off'
    buildCommand: npm ci
    startCommand: npm start
    healthCheckPath: /health/live
    envVars:
      - key: NODE_ENV
        value: staging
      - key: DATABASE_URL
        fromDatabase:
          name: family-os-foundation-staging-postgres
          property: connectionString
      - key: OIDC_ISSUER
        sync: false
      - key: OIDC_AUDIENCE
        sync: false
      - key: OIDC_JWKS_URL
        sync: false
      - key: GUARDIAN_TRANSFER_TTL_HOURS
        sync: false

databases:
  - name: family-os-foundation-staging-postgres
    region: oregon
    plan: free
    ipAllowList: []
