# Local/deployment configuration only. Do not commit a populated .env file.
# Render provides these as dashboard/Blueprint secret environment variables.
PORT=10000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
OIDC_ISSUER=https://issuer.example.com/
OIDC_AUDIENCE=family-os-api
OIDC_JWKS_URL=https://issuer.example.com/.well-known/jwks.json
# Deployment-owned policy: active co-guardian must accept a transfer before this window closes.
GUARDIAN_TRANSFER_TTL_HOURS=72
