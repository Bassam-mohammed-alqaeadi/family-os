{
  "openapi": "3.1.0",
  "info": {
    "title": "Family OS Foundation API",
    "version": "0.1.0-foundation",
    "description": "Render-first contract for the authorized account, family, membership, guardian-transfer, audit and readiness foundation. This document describes implemented local API behavior only; it does not authorize deployment, Flutter production use, account recovery, support operations, Firebase, device control, billing, AI, realtime or release claims."
  },
  "tags": [
    { "name": "Health", "description": "Process and dependency truth endpoints." },
    { "name": "Families", "description": "Server-authorized family and membership operations." },
    { "name": "Guardian continuity", "description": "Two-party primary-guardian transfer, not lost-account recovery." },
    { "name": "Audit", "description": "Guardian-scoped minimum audit envelope." },
    { "name": "Devices", "description": "Guardian-authorized linked-device latest telemetry." }
  ],
  "paths": {
    "/health/live": {
      "get": {
        "tags": ["Health"],
        "operationId": "getLiveness",
        "summary": "Check process liveness only",
        "responses": {
          "200": {
            "description": "The process is running; this does not prove database, identity or schema readiness.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LiveStatus" } } }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "tags": ["Health"],
        "operationId": "getReadiness",
        "summary": "Check configuration, database and reviewed schema readiness",
        "responses": {
          "200": {
            "description": "Required configuration and PostgreSQL schema are ready.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ReadyStatus" } } }
          },
          "503": {
            "description": "At least one required dependency or configuration is not ready; no protected capability should be claimed.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/NotReadyStatus" } } }
          }
        }
      }
    },
    "/v1/me/families": {
      "get": {
        "tags": ["Families"],
        "operationId": "listMyFamilies",
        "summary": "Discover only the verified principal's active families",
        "description": "The server derives eligible families from the verified principal. This read accepts no query parameters and returns no partial result when the bounded discovery limit is exceeded.",
        "security": [{ "oidcBearer": [] }],
        "responses": {
          "200": { "description": "Minimal active-family discovery envelope, or an empty envelope when the verified principal has no eligible family.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/FamilyDiscoveryResponse" } } } },
          "400": { "$ref": "#/components/responses/InvalidRequest" },
          "401": { "$ref": "#/components/responses/AuthenticationRequired" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "503": { "$ref": "#/components/responses/ServiceNotReady" }
        }
      }
    },
    "/v1/families": {
      "post": {
        "tags": ["Families"],
        "operationId": "createFamily",
        "summary": "Create a family with the verified principal as active primary guardian",
        "security": [{ "oidcBearer": [] }],
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateFamilyRequest" } } }
        },
        "responses": {
          "201": { "description": "Family created or durable idempotent replay returned.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/FamilyResponse" } } } },
          "400": { "$ref": "#/components/responses/InvalidRequest" },
          "401": { "$ref": "#/components/responses/AuthenticationRequired" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "503": { "$ref": "#/components/responses/ServiceNotReady" }
        }
      }
    },
    "/v1/families/{familyId}": {
      "get": {
        "tags": ["Families"],
        "operationId": "getFamily",
        "summary": "Read a family only as an active family member",
        "security": [{ "oidcBearer": [] }],
        "parameters": [{ "$ref": "#/components/parameters/FamilyId" }],
        "responses": {
          "200": { "description": "Family membership envelope.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/FamilyResponse" } } } },
          "400": { "$ref": "#/components/responses/InvalidRequest" },
          "401": { "$ref": "#/components/responses/AuthenticationRequired" },
          "403": { "$ref": "#/components/responses/FamilyAccessDenied" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "503": { "$ref": "#/components/responses/ServiceNotReady" }
        }
      }
    },
    "/v1/families/{familyId}/children": {
      "get": {
        "tags": ["Families"],
        "operationId": "listFamilyChildren",
        "summary": "Read the verified guardian's durable children roster",
        "description": "Only active guardian memberships can read this parent control-centre roster. Device, location and policy state are deliberately outside this roster endpoint.",
        "security": [{ "oidcBearer": [] }],
        "parameters": [{ "$ref": "#/components/parameters/FamilyId" }],
        "responses": {
          "200": { "description": "Durable child profile roster, including an empty roster.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/FamilyChildListResponse" } } } },
          "400": { "$ref": "#/components/responses/InvalidRequest" },
          "401": { "$ref": "#/components/responses/AuthenticationRequired" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "503": { "$ref": "#/components/responses/ServiceNotReady" }
        }
      },
      "post": {
        "tags": ["Families"],
        "operationId": "createFamilyChild",
        "summary": "Create one durable child profile as the active primary guardian",
        "description": "This creates only a durable family roster profile, including its selected avatar emoji and named theme swatch. It does not create a child login, pair a device, report location, or apply a policy.",
        "security": [{ "oidcBearer": [] }],
        "parameters": [{ "$ref": "#/components/parameters/FamilyId" }, { "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateFamilyChildRequest" } } } },
        "responses": {
          "201": { "description": "Child profile created or durable idempotent replay returned.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/FamilyChildResponse" } } } },
          "400": { "$ref": "#/components/responses/InvalidRequest" },
          "401": { "$ref": "#/components/responses/AuthenticationRequired" },
          "403": { "$ref": "#/components/responses/FamilyAccessDenied" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "503": { "$ref": "#/components/responses/ServiceNotReady" }
        }
      }
    },
    "/v1/families/{familyId}/devices": {
      "get": {
            "tags": [
                  "Devices"
            ],
            "operationId": "listFamilyDevices",
            "summary": "Read linked family devices and their latest telemetry as an active guardian",
            "description": "Returns only the latest stored telemetry for linked devices. It is not a location history endpoint and makes no claim about background collection freshness beyond lastSeenAt.",
            "security": [
                  {
                        "oidcBearer": []
                  }
            ],
            "parameters": [
                  {
                        "$ref": "#/components/parameters/FamilyId"
                  }
            ],
            "responses": {
                  "200": {
                        "description": "Linked devices with their latest authorized telemetry.",
                        "content": {
                              "application/json": {
                                    "schema": {
                                          "$ref": "#/components/schemas/FamilyDeviceListResponse"
                                    }
                              }
                        }
                  },
                  "400": {
                        "$ref": "#/components/responses/InvalidRequest"
                  },
                  "401": {
                        "$ref": "#/components/responses/AuthenticationRequired"
                  },
                  "403": {
                        "$ref": "#/components/responses/Forbidden"
                  },
                  "429": {
                        "$ref": "#/components/responses/RateLimited"
                  },
                  "503": {
                        "$ref": "#/components/responses/ServiceNotReady"
                  }
            }
      }
},
    "/v1/families/{familyId}/children/{childId}/devices": {
      "post": {
            "tags": [
                  "Devices"
            ],
            "operationId": "registerFamilyChildDevice",
            "summary": "Link one device to an existing child profile as the active primary guardian",
            "description": "Phase 1 registration is guardian-authorized. A device credential or Android background service is not created by this endpoint.",
            "security": [
                  {
                        "oidcBearer": []
                  }
            ],
            "parameters": [
                  {
                        "$ref": "#/components/parameters/FamilyId"
                  },
                  {
                        "$ref": "#/components/parameters/ChildId"
                  },
                  {
                        "$ref": "#/components/parameters/IdempotencyKey"
                  }
            ],
            "requestBody": {
                  "required": true,
                  "content": {
                        "application/json": {
                              "schema": {
                                    "$ref": "#/components/schemas/RegisterFamilyChildDeviceRequest"
                              }
                        }
                  }
            },
            "responses": {
                  "201": {
                        "description": "Device linked or durable idempotent replay returned.",
                        "content": {
                              "application/json": {
                                    "schema": {
                                          "$ref": "#/components/schemas/FamilyDeviceResponse"
                                    }
                              }
                        }
                  },
                  "400": {
                        "$ref": "#/components/responses/InvalidRequest"
                  },
                  "401": {
                        "$ref": "#/components/responses/AuthenticationRequired"
                  },
                  "403": {
                        "$ref": "#/components/responses/FamilyAccessDenied"
                  },
                  "404": {
                        "$ref": "#/components/responses/NotFound"
                  },
                  "409": {
                        "$ref": "#/components/responses/Conflict"
                  },
                  "429": {
                        "$ref": "#/components/responses/RateLimited"
                  },
                  "503": {
                        "$ref": "#/components/responses/ServiceNotReady"
                  }
            }
      }
},
    "/v1/families/{familyId}/children/{childId}/device-pairings": {
      "post": {
        "tags": ["Devices"],
        "operationId": "createDevicePairing",
        "summary": "Create an expiring one-time child-device pairing code as the active primary guardian",
        "description": "The raw pairing code is returned once, while the server retains only its digest. It must be claimed by a child device before expiry. Requires a bearer whose e-mail is verified (`email_verified` claim); otherwise 403 `email_verification_required`.",
        "security": [{ "oidcBearer": [] }],
        "parameters": [{ "$ref": "#/components/parameters/FamilyId" }, { "$ref": "#/components/parameters/ChildId" }, { "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateDevicePairingRequest" } } } },
        "responses": {
          "201": { "description": "One-time pairing capability created.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DevicePairingResponse" } } } },
          "400": { "$ref": "#/components/responses/InvalidRequest" },
          "401": { "$ref": "#/components/responses/AuthenticationRequired" },
          "403": { "$ref": "#/components/responses/FamilyAccessDenied" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "503": { "$ref": "#/components/responses/ServiceNotReady" }
        }
      }
    },
    "/v1/device-pairings/claim": {
      "post": {
        "tags": ["Devices"],
        "operationId": "claimDevicePairing",
        "summary": "Claim a one-time pairing code from a child device",
        "description": "This unauthenticated bootstrap endpoint is IP-rate-limited. A successful response returns a device credential once; the code cannot be claimed again.",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ClaimDevicePairingRequest" } } } },
        "responses": {
          "201": { "description": "Device paired and device credential issued once.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ClaimDevicePairingResponse" } } } },
          "400": { "$ref": "#/components/responses/InvalidRequest" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "503": { "$ref": "#/components/responses/ServiceNotReady" }
        }
      }
    },
    "/v1/devices/{deviceId}/telemetry": {
      "post": {
        "tags": ["Devices"],
        "operationId": "ingestDeviceTelemetry",
        "summary": "Store one linked device latest telemetry update",
        "description": "Accepts latest telemetry from an active primary guardian during controlled support operations or from the paired child device using its Device capability. The device capability is not a guardian bearer token.",
        "security": [{ "oidcBearer": [] }, { "deviceCredential": [] }],
        "parameters": [{ "$ref": "#/components/parameters/DeviceId" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DeviceTelemetryRequest" } } } },
        "responses": {
          "200": { "description": "Latest telemetry accepted.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/FamilyDeviceResponse" } } } },
          "400": { "$ref": "#/components/responses/InvalidRequest" },
          "401": { "$ref": "#/components/responses/AuthenticationRequired" },
          "403": { "$ref": "#/components/responses/FamilyAccessDenied" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "503": { "$ref": "#/components/responses/ServiceNotReady" }
        }
      }
    },
    "/v1/families/{familyId}/memberships": {
      "post": {
        "tags": ["Families"],
        "operationId": "createMembershipInvitation",
        "summary": "Primary guardian creates a pending co-guardian or child membership for a known OIDC subject",
        "description": "This Foundation endpoint does not send email, push or other invitation delivery. It does not expose a finished consumer invitation experience.",
        "security": [{ "oidcBearer": [] }],
        "parameters": [{ "$ref": "#/components/parameters/FamilyId" }, { "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateMembershipRequest" } } } },
        "responses": {
          "201": { "description": "Pending membership created or durable idempotent replay returned.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MembershipResponse" } } } },
          "400": { "$ref": "#/components/responses/InvalidRequest" },
          "401": { "$ref": "#/components/responses/AuthenticationRequired" },
          "403": { "$ref": "#/components/responses/FamilyAccessDenied" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "503": { "$ref": "#/components/responses/ServiceNotReady" }
        }
      }
    },
    "/v1/families/{familyId}/memberships/{membershipId}/accept": {
      "post": {
        "tags": ["Families"],
        "operationId": "acceptMembershipInvitation",
        "summary": "Accept a pending membership only as the exact nominated verified principal",
        "security": [{ "oidcBearer": [] }],
        "parameters": [{ "$ref": "#/components/parameters/FamilyId" }, { "$ref": "#/components/parameters/MembershipId" }, { "$ref": "#/components/parameters/IdempotencyKey" }],
        "responses": {
          "200": { "description": "Membership activated or durable idempotent replay returned.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MembershipResponse" } } } },
          "400": { "$ref": "#/components/responses/InvalidRequest" },
          "401": { "$ref": "#/components/responses/AuthenticationRequired" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "503": { "$ref": "#/components/responses/ServiceNotReady" }
        }
      }
    },
    "/v1/families/{familyId}/memberships/{membershipId}/revoke": {
      "post": {
        "tags": ["Families"],
        "operationId": "revokeMembership",
        "summary": "Revoke a pending invite or remove an active non-primary membership",
        "description": "Only the active primary guardian may perform this operation. Primary guardian removal requires the separate guardian continuity process.",
        "security": [{ "oidcBearer": [] }],
        "parameters": [{ "$ref": "#/components/parameters/FamilyId" }, { "$ref": "#/components/parameters/MembershipId" }, { "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RevokeMembershipRequest" } } } },
        "responses": {
          "200": { "description": "Membership transitioned to revoked or removed; evidence remains durable.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MembershipResponse" } } } },
          "400": { "$ref": "#/components/responses/InvalidRequest" },
          "401": { "$ref": "#/components/responses/AuthenticationRequired" },
          "403": { "$ref": "#/components/responses/FamilyAccessDenied" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "503": { "$ref": "#/components/responses/ServiceNotReady" }
        }
      }
    },
    "/v1/families/{familyId}/guardian-transfers": {
      "post": {
        "tags": ["Guardian continuity"],
        "operationId": "createGuardianTransfer",
        "summary": "Request an expiry-bound transfer from current primary guardian to active co-guardian",
        "description": "This is not lost-account recovery, dispute resolution, custody determination or a generic role edit.",
        "security": [{ "oidcBearer": [] }],
        "parameters": [{ "$ref": "#/components/parameters/FamilyId" }, { "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateGuardianTransferRequest" } } } },
        "responses": {
          "201": { "description": "Pending two-party transfer case created.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GuardianTransferResponse" } } } },
          "400": { "$ref": "#/components/responses/InvalidRequest" },
          "401": { "$ref": "#/components/responses/AuthenticationRequired" },
          "403": { "$ref": "#/components/responses/FamilyAccessDenied" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "503": { "$ref": "#/components/responses/ServiceNotReady" }
        }
      }
    },
    "/v1/families/{familyId}/guardian-transfers/{transferId}/accept": {
      "post": {
        "tags": ["Guardian continuity"],
        "operationId": "acceptGuardianTransfer",
        "summary": "Complete an unexpired guardian transfer only as the nominated active co-guardian",
        "security": [{ "oidcBearer": [] }],
        "parameters": [{ "$ref": "#/components/parameters/FamilyId" }, { "$ref": "#/components/parameters/TransferId" }, { "$ref": "#/components/parameters/IdempotencyKey" }],
        "responses": {
          "200": { "description": "The family primary reference and both guardian roles changed atomically.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GuardianTransferResponse" } } } },
          "400": { "$ref": "#/components/responses/InvalidRequest" },
          "401": { "$ref": "#/components/responses/AuthenticationRequired" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "503": { "$ref": "#/components/responses/ServiceNotReady" }
        }
      }
    },
    "/v1/families/{familyId}/guardian-transfers/{transferId}/cancel": {
      "post": {
        "tags": ["Guardian continuity"],
        "operationId": "cancelGuardianTransfer",
        "summary": "Cancel a pending guardian transfer only as its initiating current primary guardian",
        "security": [{ "oidcBearer": [] }],
        "parameters": [{ "$ref": "#/components/parameters/FamilyId" }, { "$ref": "#/components/parameters/TransferId" }, { "$ref": "#/components/parameters/IdempotencyKey" }],
        "responses": {
          "200": { "description": "Transfer cancelled with durable evidence.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GuardianTransferResponse" } } } },
          "400": { "$ref": "#/components/responses/InvalidRequest" },
          "401": { "$ref": "#/components/responses/AuthenticationRequired" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "503": { "$ref": "#/components/responses/ServiceNotReady" }
        }
      }
    },
    "/v1/families/{familyId}/audit-events": {
      "get": {
        "tags": ["Audit"],
        "operationId": "listFamilyAuditEvents",
        "summary": "List the current guardian-scoped minimum audit envelope",
        "security": [{ "oidcBearer": [] }],
        "parameters": [{ "$ref": "#/components/parameters/FamilyId" }],
        "responses": {
          "200": { "description": "Maximum one hundred newest minimum audit envelope entries.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AuditEventListResponse" } } } },
          "400": { "$ref": "#/components/responses/InvalidRequest" },
          "401": { "$ref": "#/components/responses/AuthenticationRequired" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "503": { "$ref": "#/components/responses/ServiceNotReady" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "oidcBearer": { "type": "http", "scheme": "bearer", "bearerFormat": "OIDC access token", "description": "Issuer, audience, signature and subject are verified server-side. Provider selection is not represented in this contract." },
      "deviceCredential": { "type": "apiKey", "in": "header", "name": "Authorization", "description": "One-time paired child-device capability in the form Device token. It is stored only in Android Keystore, not as a guardian bearer token." }
    },
    "parameters": {
      "FamilyId": { "name": "familyId", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/Uuid" } },
      "ChildId": { "name": "childId", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/Uuid" } },
      "DeviceId": { "name": "deviceId", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/Uuid" } },
      "MembershipId": { "name": "membershipId", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/Uuid" } },
      "TransferId": { "name": "transferId", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/Uuid" } },
      "IdempotencyKey": { "name": "Idempotency-Key", "in": "header", "required": true, "schema": { "type": "string", "minLength": 1, "maxLength": 128 }, "description": "Unique per operation intent. Reusing it with different intent is rejected." }
    },
    "responses": {
      "InvalidRequest": { "description": "Malformed JSON, identifier or input contract.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
      "AuthenticationRequired": { "description": "Missing, invalid, expired or otherwise unverifiable OIDC bearer token.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
      "FamilyAccessDenied": { "description": "No permitted active family membership for the requested action.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
      "Forbidden": { "description": "Verified principal lacks the exact required authority.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
      "NotFound": { "description": "Requested resource was not found within the authorized path.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
      "Conflict": { "description": "State, idempotency, continuity, expiry or lifecycle conflict.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
      "RateLimited": { "description": "The verified principal exceeded the protected API request allowance. Respect the standard RateLimit response header before retrying.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
      "ServiceNotReady": { "description": "Configuration, database or reviewed schema is not ready for protected operations.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
    },
    "schemas": {
      "Uuid": { "type": "string", "format": "uuid", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$" },
      "LiveStatus": { "type": "object", "required": ["status"], "properties": { "status": { "const": "live" } }, "additionalProperties": false },
      "ReadyStatus": { "type": "object", "required": ["status"], "properties": { "status": { "const": "ready" } }, "additionalProperties": false },
