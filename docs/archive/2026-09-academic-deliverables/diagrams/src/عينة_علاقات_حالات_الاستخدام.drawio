<mxfile host="app.diagrams.net" modified="2026-09-20T14:00:00.000Z" agent="family-os-docs" version="24.7.7">
  <diagram name="عينة العلاقات" id="uc-rel-sample">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="1" pageWidth="1169" pageHeight="826">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />
        <!-- حدود النظام -->
        <mxCell id="sys" value="نظام «عائلتي» (Family OS)" style="rounded=0;html=1;verticalAlign=top;fontSize=14;fontStyle=1;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="260" y="60" width="620" height="640" as="geometry" /></mxCell>
        <!-- الفاعلون: تعميم الوالد -->
        <mxCell id="parent" value="الوالد (Parent)" style="shape=umlActor;verticalLabelPosition=bottom;html=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="300" width="40" height="80" as="geometry" /></mxCell>
        <mxCell id="father" value="الأب (OWNER)" style="shape=umlActor;verticalLabelPosition=bottom;html=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="480" width="40" height="80" as="geometry" /></mxCell>
        <mxCell id="mother" value="الأم (PARENT)" style="shape=umlActor;verticalLabelPosition=bottom;html=1;" vertex="1" parent="1">
          <mxGeometry x="160" y="480" width="40" height="80" as="geometry" /></mxCell>
        <!-- تعميم الفاعلين: سهم مثلث مغلق -->
        <mxCell id="gen1" style="endArrow=block;endFill=0;endSize=16;html=1;" edge="1" parent="1" source="father" target="parent"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="gen2" style="endArrow=block;endFill=0;endSize=16;html=1;" edge="1" parent="1" source="mother" target="parent"><mxGeometry relative="1" as="geometry" /></mxCell>
        <!-- الحالات -->
        <mxCell id="uc_approve" value="اعتماد إنجاز مهمة" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e7f7ee;" vertex="1" parent="1">
          <mxGeometry x="330" y="120" width="180" height="60" as="geometry" /></mxCell>
        <mxCell id="uc_deposit" value="إيداع دقائق في المحفظة" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff8e7;" vertex="1" parent="1">
          <mxGeometry x="640" y="120" width="190" height="60" as="geometry" /></mxCell>
        <mxCell id="uc_grant" value="منح وقت إضافي (سقف ≤٣٠ د)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e7f7ee;" vertex="1" parent="1">
          <mxGeometry x="330" y="300" width="200" height="60" as="geometry" /></mxCell>
        <mxCell id="uc_over" value="تجاوز السقف (الأب حصراً)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffecec;" vertex="1" parent="1">
          <mxGeometry x="640" y="300" width="190" height="60" as="geometry" /></mxCell>
        <mxCell id="uc_lock" value="قفل جهاز الابن" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e7f7ee;" vertex="1" parent="1">
          <mxGeometry x="330" y="480" width="180" height="60" as="geometry" /></mxCell>
        <mxCell id="uc_lock_now" value="قفل فوري" style="ellipse;whiteSpace=wrap;html=1;fillColor=#eef2ff;" vertex="1" parent="1">
          <mxGeometry x="620" y="440" width="130" height="50" as="geometry" /></mxCell>
        <mxCell id="uc_lock_sched" value="قفل مجدول (وضع النوم)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#eef2ff;" vertex="1" parent="1">
          <mxGeometry x="620" y="520" width="170" height="50" as="geometry" /></mxCell>
        <mxCell id="uc_audit" value="تسجيل في سجل التدقيق" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff8e7;" vertex="1" parent="1">
          <mxGeometry x="640" y="620" width="190" height="55" as="geometry" /></mxCell>
        <!-- علاقة تضمين: متقطع + <<تضمين>> -->
        <mxCell id="inc1" value="&#171;تضمين&#187;" style="endArrow=open;dashed=1;html=1;fontSize=11;" edge="1" parent="1" source="uc_approve" target="uc_deposit"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="inc2" value="&#171;تضمين&#187;" style="endArrow=open;dashed=1;html=1;fontSize=11;" edge="1" parent="1" source="uc_lock" target="uc_audit"><mxGeometry relative="1" as="geometry" /></mxCell>
        <!-- علاقة توسيع: متقطع عكسي + <<توسيع>> -->
        <mxCell id="ext1" value="&#171;توسيع&#187;" style="endArrow=open;dashed=1;html=1;fontSize=11;" edge="1" parent="1" source="uc_over" target="uc_grant"><mxGeometry relative="1" as="geometry" /></mxCell>
        <!-- تعميم الحالات -->
        <mxCell id="gen3" style="endArrow=block;endFill=0;endSize=16;html=1;" edge="1" parent="1" source="uc_lock_now" target="uc_lock"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="gen4" style="endArrow=block;endFill=0;endSize=16;html=1;" edge="1" parent="1" source="uc_lock_sched" target="uc_lock"><mxGeometry relative="1" as="geometry" /></mxCell>
        <!-- ارتباطات الفاعل -->
        <mxCell id="a1" style="endArrow=none;html=1;" edge="1" parent="1" source="parent" target="uc_approve"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a2" style="endArrow=none;html=1;" edge="1" parent="1" source="parent" target="uc_grant"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a3" style="endArrow=none;html=1;" edge="1" parent="1" source="parent" target="uc_lock"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a4" style="endArrow=none;html=1;" edge="1" parent="1" source="father" target="uc_over"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
